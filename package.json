{
  "name": "mwa-reference",
  "description": "An Ionic project",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "./build.sh",
    "build-local": "tsc && vite build --mode production",
    "serve": "vite preview",
    "ionic:serve": "vite dev --host",
    "ios": "ionic capacitor run ios --external --livereload -p 5173",
    "android": "ionic capacitor run android --external --livereload -p 5173",
    "local-setup": "husky install && npm install",
    "lint": "eslint --ext js,jsx,ts,tsx src",
    "lint-fix": "eslint --fix --ext js,jsx,ts,tsx src",
    "test": "node --experimental-strip-types --test",
    "tsc": "tsc",
    "nuke:cache": "rm -rf ./node_modules/.cache"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@egym/capacitor-nfc-pass-wallet": "^0.4.2",
    "@egym/mwa-logger": "^0.4.0",
    "@egym/mwa-utils": "^0.8.4",
    "@ionic/portals": "^0.13.0",
    "@ionic/react": "^9.0.9",
    "@ionic/react-router": "^9.0.9",
    "@tanstack/react-query": "^5.104.5",
    "date-fns": "^2.30.0",
    "framer-motion": "^14.6.0",
    "history": "^5.3.0",
    "i18next": "^23.10.1",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-http-backend": "^4.0.4",
    "ionicons": "^8.1.0",
    "jwt-decode": "^4.0.0",
    "luxon": "^3.4.4",
    "msw": "^3.0.3",
    "path-to-regexp": "^6.2.1",
    "qs": "^6.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^14.1.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "react-use": "^17.6.1",
    "reselect": "^5.3.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@ionic/prettier-config": "^4.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/qs": "^6.9.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^8.0.3",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "sass": "^1.74.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-svgr": "^5.2.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "peerDependencies": {
    "typescript": "^4.9.5"
  }
}
